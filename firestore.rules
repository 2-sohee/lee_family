rules_version = '2';

// Access is granted by the family document's memberEmails/adminEmails lists,
// which only administrators can change from the in-app admin page.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function isMember(familyId) {
      return signedIn() && exists(familyPath(familyId)) &&
        myEmail() in get(familyPath(familyId)).data.memberEmails;
    }

    function isAdmin(familyId) {
      return signedIn() && exists(familyPath(familyId)) &&
        myEmail() in get(familyPath(familyId)).data.adminEmails;
    }

    function validAccessLists(data) {
      return data.memberEmails is list && data.adminEmails is list &&
        data.adminEmails.size() > 0 &&
        data.memberEmails.hasAll(data.adminEmails);
    }

    // Accounts created from the app are always regular users; only the fixed
    // system admin (provisioned server-side) may hold the admin role.
    function roleAllowed(familyId, data) {
      return !("role" in data) || data.role != "admin" ||
        data.email in get(familyPath(familyId)).data.adminEmails;
    }

    match /families/{familyId} {
      allow get: if isMember(familyId);
      allow list: if false;
      // The family workspace and its admin are provisioned server-side only.
      allow create, delete: if false;
      // The admin list is fixed; admins manage members but cannot change admins.
      allow update: if isAdmin(familyId) &&
        validAccessLists(request.resource.data) &&
        request.resource.data.adminEmails == resource.data.adminEmails;

      match /members/{username} {
        allow read: if isMember(familyId);
        allow delete: if isAdmin(familyId) && !(resource.data.email in get(familyPath(familyId)).data.adminEmails);
        allow create: if isAdmin(familyId) && roleAllowed(familyId, request.resource.data);
        allow update: if (isAdmin(familyId) && roleAllowed(familyId, request.resource.data)) ||
          (isMember(familyId) &&
           resource.data.email == myEmail() &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["name", "englishName", "avatar", "photo", "color"]));
      }

      match /state/{name} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId) &&
          name in ["ingredients", "events", "chores", "notices", "shopping", "purchases", "budget"] &&
          request.resource.data.items is list;
      }

      match /fridgePhotos/{photoId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && request.resource.data.dataUrl is string;
        allow delete: if isMember(familyId);
      }
    }
  }
}
